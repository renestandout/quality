{
  "extends": "@standout/quality/tsconfig-strict",
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "target": "es2023",
    "types": ["node"]
  },
  "include": [
    "*.js",
    "bin/*.mjs",
    "configs/*.js",
    "configs/*.mjs",
    "guards/*.mjs",
    "hooks/**/*.mjs",
    "lib/*.mjs",
    "stacks/*.mjs"
  ]
}
