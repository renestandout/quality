# Gemeinsame PHPStan-Grundlage für Standout-Projekte.
#
# Einbinden in der projekteigenen phpstan.neon — Larastan zuerst, damit dessen
# Erweiterungen greifen:
#
#     includes:
#         - vendor/larastan/larastan/extension.neon
#         - vendor/standout/quality/configs/phpstan/base.neon
#         - phpstan-baseline.neon        # nur bei baseline: true
#
#     parameters:
#         paths:
#             - app
#             - database
#             - routes
#         phpVersion: 80300              # PHP-Version der LAUFZEIT, nicht der Entwicklungsmaschine
#
# Das Level steht bewusst nicht hier: es kommt aus quality.yml und wird vom
# Runner als --level übergeben, damit es eine einzige Quelle der Wahrheit gibt.

parameters:
    # Meldet Baseline-Einträge, für die es keinen Fehler mehr gibt. Ohne das
    # wächst eine Baseline nur und niemand merkt, wenn sie schrumpfen könnte.
    reportUnmatchedIgnoredErrors: true

    # PHPDoc-Angaben werden nicht als gesichert behandelt. In gewachsenem Code
    # sind sie oft veraltet; sie als Wahrheit zu nehmen erzeugt Folgefehler,
    # die auf die Doku statt auf den Code zeigen.
    treatPhpDocTypesAsCertain: false

    # Fehlerhafte Ignore-Kommentare sollen auffallen statt still zu wirken.
    reportWrongPhpDocTypeInVarTag: true

    # tmpDir steht bewusst NICHT hier. Ein projektlokaler Cache liesse sich in
    # CI zwar wiederverwenden, aber er erzeugt ein Verzeichnis im Projekt, das
    # jeder selbst in .gitignore aufnehmen müsste — und wer das vergisst,
    # bekommt den Cache vom Tamper-Check als neuen Code vorgehalten (genau so
    # beim adboard-Rollout passiert). PHPStans Standard im System-Temp ist
    # spurenfrei und wird zwischen Läufen ebenso wiederverwendet.
    #
    # »Wird zwischen Läufen wiederverwendet« gilt aber nur, wo der System-Temp
    # den Lauf überlebt. Das trennt die beiden Runner-Typen:
    #
    #   self-hosted: /tmp bleibt stehen, der Cache ist ab dem zweiten Lauf warm.
    #                Nichts zu tun — genau der Fall, für den der Standard gemacht
    #                ist. Gemessen in rankscan/application am 19.08.2026: PHPStan
    #                86s kalt, 6s warm; der ganze quality-Job 4:07 -> 1:01.
    #   ubuntu-latest: jeder Lauf startet mit leerem /tmp, also immer kalt. Wer
    #                den Gewinn dort will, legt actions/cache auf /tmp/phpstan
    #                (der Standardpfad, sys_get_temp_dir() + '/phpstan') —
    #                fertiger Block in examples/ci-split-static-tests.yml.
    #                Abwägung: der Cache wird schnell dreistellig gross (113 MB
    #                in rankscan/application), Hoch- und Runterladen kostet also
    #                einen Teil des Gewinns zurück.
    #
    # In beiden Fällen bleibt tmpDir aus der Projektkonfiguration draussen. Wer
    # von ubuntu-latest auf self-hosted wechselt und ein tmpDir gesetzt hat,
    # entfernt es dabei — siehe docs/self-hosted-runner.md.

    excludePaths:
        analyseAndScan:
            - */vendor/*
            - */node_modules/*
            - */storage/*
            - */bootstrap/cache/*
