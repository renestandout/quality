# Umgebung für Sandbox-Läufe in resplan (Node 24, MariaDB).
# Nur Dummy-Werte. Nie echte Secrets eintragen.
# MOCO_*, AWS_*, CRON_SECRET, MAIL_* und Google fehlen absichtlich. Braucht eine
# Spur einen Wert, trägt der Verifier einen Dummy-Wert in seinen Befehl ein.
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
HOME=/scratch/home
TMPDIR=/scratch/tmp
XDG_CACHE_HOME=/scratch/cache
NODE_ENV=test
NEXT_TELEMETRY_DISABLED=1
DATABASE_URL=mysql://db:db@127.0.0.1:3306/db_test
AUTH_SECRET=test
AUTH_URL=http://127.0.0.1:3000
