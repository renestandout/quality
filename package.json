{
  "name": "@standout/quality",
  "version": "0.2.3",
  "description": "Gemeinsame Code-Quality-Werkzeuge für Standout-Projekte: Runner, Stack-Adapter und Basiskonfiguration.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "bin": {
    "quality": "bin/quality"
  },
  "exports": {
    "./prettier": "./configs/prettier.config.js",
    "./tsconfig": "./configs/tsconfig.base.json",
    "./tsconfig-strict": "./configs/tsconfig.strict.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "stacks",
    "guards",
    "configs",
    "hooks",
    "skills",
    ".claude-plugin"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test 'lib/*.test.mjs' 'guards/*.test.mjs' 'configs/*.test.mjs'"
  }
}
